#!/bin/bash
# Pre-push: stack-agnostic security review using grep.
# Hard-fails on hardcoded secrets in changed files. Soft-warns on
# console.log / print() / TODO+FIXME in newly added lines.

set -e

REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "$REPO_ROOT"

# git runs hooks with a minimal environment, so the scanners below have to be
# findable by absolute convention rather than by the user's interactive PATH.
# $HOME/.cargo/bin is rustup's default (cargo-audit / cargo-deny / clippy);
# $HOME/.local/bin is where pipx, `pip install --user` and hand-rolled venv
# symlinks land, which is where zizmor is. Miss either and the check prints
# "command not found" — or, worse, quietly no-ops past a real finding.
export PATH="$PATH:$HOME/.local/bin:$HOME/.cargo/bin:/usr/local/bin:/opt/homebrew/bin"

echo "🔍 pre-push: security review"
echo "─────────────────────────────────────────────"

# === Audit freshness preflight (report-only per rules-as-gates.md §3;
#     ratchet to blocking = owner decision, parked in needs-owner.md) ======
AUDIT_LOG="$REPO_ROOT/.claude/audit-log.md"
if [ -f "$AUDIT_LOG" ]; then
    LAST_AUDIT="$(grep -m1 -oE '^## Audyt [0-9]{4}-[0-9]{2}-[0-9]{2}' "$AUDIT_LOG" \
        | grep -oE '[0-9]{4}-[0-9]{2}-[0-9]{2}' || true)"
    if [ -n "$LAST_AUDIT" ]; then
        # GNU date (Linux) first, BSD date (macOS) fallback.
        LAST_EPOCH="$(date -d "$LAST_AUDIT" +%s 2>/dev/null \
            || date -j -f '%Y-%m-%d' "$LAST_AUDIT" +%s 2>/dev/null || echo 0)"
        if [ "$LAST_EPOCH" -gt 0 ]; then
            AGE_DAYS=$(( ($(date +%s) - LAST_EPOCH) / 86400 ))
            if [ "$AGE_DAYS" -gt 7 ]; then
                echo "⚠️  WARN: ostatni audyt ($LAST_AUDIT, ${AGE_DAYS} dni temu) ma >7 dni."
                echo "    Uruchom skill weekly-audit (.claude/rules/audit.md)."
            fi
        fi
    fi
fi

DEFAULT_BRANCH="$(git symbolic-ref refs/remotes/origin/HEAD 2>/dev/null \
    | sed 's@^refs/remotes/origin/@@' || echo main)"

# === What is actually being pushed ========================================
# git feeds a pre-push hook one line per ref on stdin:
#     <local ref> <local sha> <remote ref> <remote sha>
# Deriving the range from HEAD instead — as this hook used to — is antipattern
# A1 in .claude/rules/rules-as-gates.md: it scans whatever the developer's
# checkout happens to be, which is not necessarily what the remote is about to
# receive. Combined with reading file contents off disk, a secret that was
# COMMITTED and then edited out of the working tree only passed cleanly.
ZERO_SHA="0000000000000000000000000000000000000000"
PUSH_TIP=""
PUSH_BASE=""
if [ ! -t 0 ]; then
    while read -r _local_ref local_sha _remote_ref remote_sha; do
        [ -z "$local_sha" ] && continue
        # All-zero local sha = branch deletion; nothing to scan.
        [ "$local_sha" = "$ZERO_SHA" ] && continue
        PUSH_TIP="$local_sha"
        if [ "$remote_sha" = "$ZERO_SHA" ] || [ -z "$remote_sha" ]; then
            # New branch on the remote: its "new" commits are the ones no
            # remote-tracking ref already contains. Diff from the parent of the
            # oldest such commit (empty tree if this is a root commit).
            oldest="$(git rev-list "$local_sha" --not --remotes 2>/dev/null | tail -1)"
            if [ -n "$oldest" ]; then
                PUSH_BASE="$(git rev-parse --verify --quiet "${oldest}^" || true)"
            else
                PUSH_BASE="$(git rev-parse "$local_sha^" 2>/dev/null || true)"
            fi
        else
            PUSH_BASE="$remote_sha"
        fi
        # One ref per push is the norm here; a multi-ref push scans the first,
        # which is strictly better than the old HEAD-derived guess. Widening
        # this to every ref is tracked in .claude/backlog.md.
        break
    done
fi

if [ -z "$PUSH_TIP" ]; then
    # No refs on stdin — a manual `bash .githooks/pre-push` run. Fall back to
    # HEAD vs the default branch, and say so, so nobody reads this run as
    # proof about a specific push.
    PUSH_TIP="$(git rev-parse HEAD)"
    PUSH_BASE="$(git rev-parse --verify --quiet "origin/$DEFAULT_BRANCH" || true)"
    echo "ℹ  No push refs on stdin — scanning HEAD vs origin/$DEFAULT_BRANCH."
fi

if [ -n "$PUSH_BASE" ]; then
    DIFF_ARGS=("$PUSH_BASE" "$PUSH_TIP")
else
    # Root commit: diff against git's empty tree so every file counts as added.
    DIFF_ARGS=("$(git hash-object -t tree /dev/null)" "$PUSH_TIP")
fi

# NUL-delimited into an array. A bare `for f in $CHANGED_FILES` word-splits any
# path containing a space (git prints those unquoted), every fragment then fails
# the `[ -f ]` guard, and the secret scan below silently SKIPS the file — a gate
# bypass, not cosmetics. Globs in a name were expanded for the same reason.
CHANGED_FILES=()
while IFS= read -r -d '' f; do
    CHANGED_FILES+=("$f")
done < <(git diff -z --name-only "${DIFF_ARGS[@]}")

if [ ${#CHANGED_FILES[@]} -eq 0 ]; then
    echo "ℹ  Nothing new in this push — skipping."
    exit 0
fi

# === Where the content scans read from ====================================
# A detached worktree of the pushed commit. The scanners below read files from
# $SCAN_ROOT, never from the developer's checkout, so an uncommitted edit can
# neither hide a committed secret nor invent a finding that is not being
# pushed. The toolchain gates (ruff / mypy / pytest / cargo / zizmor) still run
# against the real checkout on purpose: they need .venv and cargo's target dir,
# which are untracked and would be absent here — CI runs them against the
# pushed commit. A dirty tree therefore makes those gates advisory, and the
# warning below says so rather than letting it pass silently.
SCAN_ROOT="$REPO_ROOT"
SCAN_WORKTREE=""
cleanup_worktree() {
    if [ -n "$SCAN_WORKTREE" ] && [ -d "$SCAN_WORKTREE" ]; then
        git worktree remove --force "$SCAN_WORKTREE" >/dev/null 2>&1 || true
        rm -rf "$SCAN_WORKTREE" >/dev/null 2>&1 || true
    fi
}
trap cleanup_worktree EXIT

SCAN_WORKTREE="$(mktemp -d "${TMPDIR:-/tmp}/crossdesk-prepush.XXXXXX")"
if git worktree add --detach --quiet "$SCAN_WORKTREE" "$PUSH_TIP" >/dev/null 2>&1; then
    SCAN_ROOT="$SCAN_WORKTREE"
else
    echo "⚠️  WARN: could not materialise $PUSH_TIP in a temp worktree —"
    echo "    falling back to scanning the working tree, which may differ"
    echo "    from what is being pushed."
    SCAN_WORKTREE=""
fi

if [ -n "$(git status --porcelain)" ]; then
    echo "ℹ  Working tree is dirty: the content scans read the pushed commit,"
    echo "   but the toolchain gates below run against your checkout."
fi

# Replaces `echo "$CHANGED_FILES" | grep -qE`, which re-split the same way.
changed_match() {
    local pattern="$1" f
    for f in "${CHANGED_FILES[@]}"; do
        if [[ "$f" =~ $pattern ]]; then
            return 0
        fi
    done
    return 1
}

# Skip helper: returns 0 if path is a test/fixture/known-allowed file.
is_excluded() {
    case "$1" in
        node_modules/*|*.env|*/test/*|*/tests/*|test_*|*_test.*|*.spec.*|*spec.ts|*spec.tsx|*spec.js|*mock*|*fixture*|*conftest*|infra/certs/generate_mtls.sh|.githooks/*|guest/crates/proto/*|host/src/crossdesk_host/proto/*) return 0 ;;
    esac
    return 1
}

# === 0. Code-quality gates mirroring .github/workflows/ci.yml ============
# These cover what GitHub Actions checks on every push to main. Running
# them here means the GH job is just a redundant confirmation, not the
# source-of-truth — so push spam from CI flakes drops to zero. Skipped
# selectively based on which paths actually changed.

# --- 0A. Python host: ruff + mypy --strict + mock-import gate + pytest ---
if changed_match '^host/'; then
    if [ -x "$REPO_ROOT/host/.venv/bin/ruff" ]; then
        # tests/ included since audit 2026-06-12 hit 0 findings — ratchet floor.
        echo "🐍 ruff check src/ tests/ ..."
        ( cd "$REPO_ROOT/host" && .venv/bin/ruff check src/ tests/ ) || {
            echo "❌ ruff found issues. Fix locally before pushing."
            exit 1
        }
    fi
    if [ -x "$REPO_ROOT/host/.venv/bin/mypy" ]; then
        echo "🐍 mypy --strict src/ ..."
        # --python-version=3.12: lock to CI target so dev-box pythons
        # newer than 3.12 (e.g. 3.14) don't spuriously flag the tomli
        # fallback import in catalog/curated.py et al. as "unused-ignore".
        ( cd "$REPO_ROOT/host" && .venv/bin/mypy --strict --python-version=3.12 src/ ) || {
            echo "❌ mypy --strict failed. Fix locally before pushing."
            exit 1
        }
    fi
    # Mock-import whitelist gate (mirrors ci.yml python-host job).
    bad="$(cd "$REPO_ROOT/host" && grep -rE 'from crossdesk_host\.[^[:space:]]+\.mock import' src/ \
            | grep -v 'src/crossdesk_host/integrations/keyring/__init__\.py:' \
            | grep -v 'src/crossdesk_host/filesystem_ctl/__init__\.py:' \
            | grep -v 'src/crossdesk_host/daemon\.py:' \
            || true)"
    if [ -n "$bad" ]; then
        echo "❌ production code imports a mock module outside the whitelist:"
        echo "$bad"
        exit 1
    fi
    if [ -x "$REPO_ROOT/host/.venv/bin/pytest" ]; then
        echo "🐍 pytest -q (excluding benches/) ..."
        ( cd "$REPO_ROOT/host" && .venv/bin/pytest -x -q --no-header \
            --ignore=benches/ -p no:cacheprovider tests/ ) || {
            echo "❌ pytest failed. Fix locally before pushing."
            exit 1
        }
    fi
fi

# --- 0B. Rust guest: cargo check + test + clippy (native host arch) ------
if changed_match '^(guest|proto)/'; then
    if command -v cargo >/dev/null 2>&1; then
        echo "🦀 cargo check (guest, native) ..."
        ( cd "$REPO_ROOT/guest" && cargo check --workspace --quiet ) || {
            echo "❌ cargo check failed in guest workspace."
            exit 1
        }
        echo "🦀 cargo test (guest, --features ipc-vsock/mock) ..."
        ( cd "$REPO_ROOT/guest" && cargo test --workspace --features ipc-vsock/mock \
            --quiet ) || {
            echo "❌ cargo test failed in guest workspace."
            exit 1
        }
        echo "🦀 cargo clippy (guest, -D warnings) ..."
        ( cd "$REPO_ROOT/guest" && cargo clippy --workspace --quiet -- -D warnings ) || {
            echo "❌ cargo clippy found issues in guest workspace."
            exit 1
        }
    fi
fi

# --- 0C. Rust GUI: cargo check + test ------------------------------------
if changed_match '^(gui|proto)/'; then
    if command -v cargo >/dev/null 2>&1; then
        echo "🦀 cargo check (gui) ..."
        ( cd "$REPO_ROOT/gui" && cargo check --workspace --quiet ) || {
            echo "❌ cargo check failed in gui workspace."
            exit 1
        }
        echo "🦀 cargo test (gui) ..."
        ( cd "$REPO_ROOT/gui" && cargo test --workspace --quiet ) || {
            echo "❌ cargo test failed in gui workspace."
            exit 1
        }
    fi
fi

# --- 0D. Proto: buf lint + buf format --diff --exit-code -----------------
if changed_match '^proto/'; then
    if command -v buf >/dev/null 2>&1; then
        echo "📦 buf lint ..."
        ( cd "$REPO_ROOT/proto" && buf lint ) || {
            echo "❌ buf lint failed."
            exit 1
        }
        echo "📦 buf format --diff --exit-code ..."
        ( cd "$REPO_ROOT/proto" && buf format --diff --exit-code ) || {
            echo "❌ buf format: run 'cd proto && buf format -w' to normalize."
            exit 1
        }
    fi
fi

# --- 0E. i18n .pot synchronization (HARD FAIL when xgettext available) ---
if changed_match '^host/src/crossdesk_host/cli/|^gui/.*\.(qml|rs)$'; then
    if command -v xgettext >/dev/null 2>&1 && [ -x "$REPO_ROOT/scripts/i18n.sh" ]; then
        echo "🌍 i18n .pot extraction check ..."
        bash "$REPO_ROOT/scripts/i18n.sh" extract >/dev/null 2>&1 || true
        if ! git -C "$REPO_ROOT" diff --exit-code -- \
                i18n/crossdesk-host.pot \
                gui/crates/crossdesk-gui/i18n/crossdesk_en.ts \
                gui/crates/crossdesk-gui/i18n/crossdesk_pl.ts >/dev/null 2>&1; then
            echo "❌ i18n translation files have uncommitted changes."
            echo "   Run 'bash scripts/i18n.sh extract' and commit the result."
            exit 1
        fi
    fi
fi

# --- 0F. Workflows: zizmor (mirrors security.yml's `workflows` job) -------
# Local mirror of the CI gate. Without it, a bad workflow only surfaces after a
# push — which is exactly the local-vs-CI divergence that left main red for a
# week (2fdff19). Not a silent skip when the tool is missing: say so loudly.
if changed_match '^\.github/'; then
    if command -v zizmor >/dev/null 2>&1; then
        echo "🔬 zizmor (workflow static analysis) ..."
        zizmor --no-progress --min-severity=low "$REPO_ROOT/.github/workflows/" || {
            echo "❌ zizmor found workflow issues at low severity or above."
            echo "   Policy lives in .github/zizmor.yml (third-party actions must"
            echo "   be pinned to a full commit SHA)."
            exit 1
        }
    else
        echo "⚠️  WARN: .github/** changed but zizmor is not installed — the"
        echo "    workflow gate will only run in CI. Install:"
        echo "    python3 -m venv ~/.local/share/zizmor-venv &&"
        echo "    ~/.local/share/zizmor-venv/bin/pip install zizmor &&"
        echo "    ln -sf ~/.local/share/zizmor-venv/bin/zizmor ~/.local/bin/zizmor"
    fi
fi

# === 1. Hardcoded secrets (HARD FAIL) =====================================
echo "🔐 hardcoded secrets ..."
SECRET_PATTERNS='(password|api[_-]?key|secret|token)[[:space:]]*=[[:space:]]*["'"'"'][A-Za-z0-9._\-]{8,}["'"'"']'
SECRET_HITS=()
for f in "${CHANGED_FILES[@]}"; do
    [ -f "$SCAN_ROOT/$f" ] || continue
    is_excluded "$f" && continue
    if grep -E -l "$SECRET_PATTERNS" "$SCAN_ROOT/$f" >/dev/null 2>&1; then
        SECRET_HITS+=("$f")
    fi
done
if [ ${#SECRET_HITS[@]} -gt 0 ]; then
    echo "❌ potential hardcoded secrets in:"
    for f in "${SECRET_HITS[@]}"; do
        echo "    $f"
    done
    echo "   Move them to env vars or a gitignored .env, then retry."
    exit 1
fi

# === 2. console.log in TS/JS hot paths (WARN) =============================
echo "🖨  console.log in TS/JS ..."
COUNT=0
for f in "${CHANGED_FILES[@]}"; do
    [ -f "$f" ] || continue
    is_excluded "$f" && continue
    case "$f" in
        *.ts|*.tsx|*.js|*.jsx) ;;
        *) continue ;;
    esac
    while IFS= read -r line; do
        echo "    $f:$line"
        COUNT=$((COUNT + 1))
        [ $COUNT -ge 5 ] && break 2
    done < <(grep -n -E 'console\.(log|debug|warn)' "$SCAN_ROOT/$f" 2>/dev/null || true)
done

# === 3. print() in Python hot paths (WARN) ================================
echo "🐍 print() in Python ..."
COUNT=0
for f in "${CHANGED_FILES[@]}"; do
    [ -f "$f" ] || continue
    is_excluded "$f" && continue
    case "$f" in
        *.py) ;;
        *) continue ;;
    esac
    case "$f" in
        build_proto.py|scripts/*|tools/*) continue ;;
    esac
    while IFS= read -r line; do
        echo "    $f:$line"
        COUNT=$((COUNT + 1))
        [ $COUNT -ge 5 ] && break 2
    done < <(grep -n -E '^\s*print\(' "$SCAN_ROOT/$f" 2>/dev/null || true)
done

# === 4b. qmllint on changed QML files (HARD FAIL when tool present) =======
echo "🎨 qmllint (QML syntax) ..."
QMLLINT_BIN=""
if command -v qmllint >/dev/null 2>&1; then
    QMLLINT_BIN="qmllint"
elif [ -x /usr/lib/qt6/bin/qmllint ]; then
    QMLLINT_BIN="/usr/lib/qt6/bin/qmllint"
elif [ -x /opt/homebrew/opt/qt/bin/qmllint ]; then
    QMLLINT_BIN="/opt/homebrew/opt/qt/bin/qmllint"
fi
if [ -n "$QMLLINT_BIN" ]; then
    QML_HITS=()
    for f in "${CHANGED_FILES[@]}"; do
        case "$f" in
            *.qml) ;;
            *) continue ;;
        esac
        [ -f "$SCAN_ROOT/$f" ] || continue
        # Run from gui/ so the per-repo .qmllint.ini is picked up.
        if ! ( cd "$REPO_ROOT/gui" && "$QMLLINT_BIN" -W 0 "$SCAN_ROOT/$f" >/dev/null 2>&1 ); then
            QML_HITS+=("$f")
        fi
    done
    if [ ${#QML_HITS[@]} -gt 0 ]; then
        echo "❌ qmllint found issues in:"
        for f in "${QML_HITS[@]}"; do
            echo "    $f"
            { ( cd "$REPO_ROOT/gui" && "$QMLLINT_BIN" "$SCAN_ROOT/$f" 2>&1 \
                | grep -E "^(Warning|Error):" | head -5 | sed 's/^/      /' ); } || true
        done
        echo "   Fix the QML or adjust gui/.qmllint.ui to silence."
        exit 1
    fi
fi

# === 4. TODO/FIXME added in this push (INFO) ==============================
# Braced + `|| true`: an advisory pipeline whose grep finds nothing exits 1,
# and `head` closing the pipe raises SIGPIPE — under `set -e` either would kill
# the hook HERE, skipping every layer below while still exiting 0. That is
# antipattern A2 in rules-as-gates.md.
echo "📝 TODO/FIXME added in this push ..."
{ git diff "${DIFF_ARGS[@]}" 2>/dev/null \
    | grep -E '^\+.*(TODO|FIXME)' \
    | head -10; } || true

# === 5. Supply-chain audit (HARD FAIL when tools available) ==============
# These run automatically when the corresponding scanner is installed.
# Skipped silently if not — keeps the hook usable on minimal dev machines.
# To install everything: see docs/AUDIT_REPORT.md "How to re-run".

# The `[ -d ]` guards are not decoration: `(cd missing/ && cargo audit)` fails
# on the cd, and the `||` branch below reads that as "vulnerabilities found" —
# so a repo without a Rust workspace failed the push with a message naming a
# workspace it does not have.
if command -v cargo-audit >/dev/null 2>&1; then
    if [ -d "$REPO_ROOT/guest" ]; then
        echo "🦀 cargo audit (guest) ..."
        (cd "$REPO_ROOT/guest" && cargo audit --quiet --deny warnings 2>&1) || {
            echo "❌ cargo audit found vulnerabilities in guest workspace."
            exit 1
        }
    fi
    if [ -d "$REPO_ROOT/gui" ]; then
        echo "🦀 cargo audit (gui) ..."
        (cd "$REPO_ROOT/gui" && cargo audit --quiet --deny warnings 2>&1) || {
            echo "❌ cargo audit found vulnerabilities in gui workspace."
            exit 1
        }
    fi
fi

if command -v cargo-deny >/dev/null 2>&1; then
    if [ -d "$REPO_ROOT/guest" ]; then
        echo "🚧 cargo deny check (guest) ..."
        (cd "$REPO_ROOT/guest" && cargo deny check --hide-inclusion-graph >/dev/null 2>&1) || {
            echo "❌ cargo deny rejected guest workspace — re-run for details."
            exit 1
        }
    fi
    if [ -d "$REPO_ROOT/gui" ]; then
        echo "🚧 cargo deny check (gui) ..."
        (cd "$REPO_ROOT/gui" && cargo deny check --hide-inclusion-graph >/dev/null 2>&1) || {
            echo "❌ cargo deny rejected gui workspace — re-run for details."
            exit 1
        }
    fi
fi

if command -v gitleaks >/dev/null 2>&1; then
    echo "🔑 gitleaks (git history) ..."
    # Scan git history rather than worktree — leaves out cached
    # build artifacts under guest/target/ that contain literal PEM
    # bytes from the `pem` Rust crate (false positives) but never
    # land in committed files.
    if ! gitleaks detect --source "$REPO_ROOT" --no-banner --redact \
            --exit-code 1 >/dev/null 2>&1; then
        echo "❌ gitleaks found potential secrets in git history. Re-run:"
        echo "   gitleaks detect --source . --redact"
        exit 1
    fi
fi

# pip-audit / bandit are slower (~3-5s) and run in CI; skip locally
# unless explicitly requested via CROSSDESK_FULL_AUDIT=1.
if [ "${CROSSDESK_FULL_AUDIT:-0}" = "1" ]; then
    if command -v pip-audit >/dev/null 2>&1; then
        echo "🐍 pip-audit ..."
        pip-audit -r <(cd "$REPO_ROOT/host" && .venv/bin/pip freeze 2>/dev/null \
            | grep -v '^-e \|^crossdesk-host=') --quiet || {
            echo "❌ pip-audit found vulnerabilities."
            exit 1
        }
    fi
    if command -v bandit >/dev/null 2>&1; then
        echo "🐍 bandit (medium+) ..."
        bandit -r "$REPO_ROOT/host/src" -ll --quiet || exit 1
    fi
fi

echo "─────────────────────────────────────────────"
echo "✅ pre-push checks done."
exit 0
