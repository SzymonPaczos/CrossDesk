<RCC>
    <!-- Translations only. Icons live in icons.qrc (registered via the
         top-level CxxQtBuilder::qrc so they resolve at qrc:/icons/). The .qm
         files are produced by lrelease at build time; when the Qt linguist
         tools are absent the build still succeeds and the UI falls back to
         the source (English) strings. -->
    <qresource prefix="/i18n">
        <file alias="crossdesk_en.qm">i18n/crossdesk_en.qm</file>
        <file alias="crossdesk_pl.qm">i18n/crossdesk_pl.qm</file>
    </qresource>
</RCC>
