msgstr "uprawnienia vm.toml już 0600 w {path}"

#: host/src/crossdesk_host/cli/credentials_cmd.py:142
msgid ""
"note: full guest password re-apply for {username!r} requires a running "
"daemon and is wired through `display.session_starter` before the next RAIL "
"spawn."
msgstr ""
"uwaga: pełna zmiana hasła gościa dla {username!r} wymaga działającego demona"
" i nastąpi przez `display.session_starter` przed kolejnym uruchomieniem "
"RAIL."

#: host/src/crossdesk_host/cli/install_cmd.py:52
#, python-brace-format
msgid "crossdesk install (state at {path})"
msgstr "crossdesk install (stan zapisany w {path})"

