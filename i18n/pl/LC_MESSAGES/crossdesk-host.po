#: host/src/crossdesk_host/cli/apps_cmd.py:54
msgid "No apps in catalog."
msgstr "Brak aplikacji w katalogu."

#: host/src/crossdesk_host/cli/apps_cmd.py:71
msgid ""
"app {app_id!r} not found in catalog; run 'crossdesk apps list' to see "
"available apps."
msgstr ""
"aplikacja {app_id!r} nie znaleziona w katalogu; uruchom 'crossdesk apps "
"list' aby zobaczyć dostępne aplikacje."

#: host/src/crossdesk_host/cli/apps_cmd.py:86
#, python-brace-format
msgid "installed {name} → {path}"
msgstr "zainstalowano {name} → {path}"

