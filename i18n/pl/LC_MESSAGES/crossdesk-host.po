msgid "host updated for {username!r}"
msgstr "zaktualizowano dane hosta dla {username!r}"

#: host/src/crossdesk_host/cli/credentials_cmd.py:75
msgid ""
"(guest password change is hardware-gated; run `crossdesk vm credentials "
"repair` once VM is reachable)"
msgstr ""
"(zmiana hasła gościa wymaga działającej maszyny; uruchom `crossdesk vm "
"credentials repair` gdy maszyna jest dostępna)"

