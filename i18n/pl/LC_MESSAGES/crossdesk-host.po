msgstr "    zapisano dane logowania dla użytkownika {user!r}"

#: host/src/crossdesk_host/cli/install_cmd.py:80
#, python-brace-format
msgid "    {step}: hardware-gated; not implemented in --no-hardware mode"
msgstr "    {step}: wymaga sprzętu; niedostępne bez maszyny wirtualnej"

